<!DOCTYPE html>
<html>
<head>
  <title>Hotel Room Management</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand navbar-dark bg-dark px-3">
  <a class="navbar-brand" href="/rooms">Hotel Rooms</a>
  <div class="ms-auto">
    <% if (loggedIn) { %>
      <span class="text-white me-3">Hi, <%= userName %></span>
      <a class="btn btn-outline-light btn-sm" href="/logout">Logout</a>
    <% } else { %>
      <a class="btn btn-outline-light btn-sm me-2" href="/login">Login</a>
      <a class="btn btn-outline-light btn-sm" href="/register">Register</a>
    <% } %>
  </div>
</nav>

<div class="container my-4">