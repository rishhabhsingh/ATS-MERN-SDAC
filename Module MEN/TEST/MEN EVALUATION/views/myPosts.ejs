<%- include("partials/header") %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2 class="mb-0">My posts</h2>
  <a href="/posts/add" class="btn btn-ink">New post</a>
</div>

<% if (posts.length === 0) { %>
  <div class="empty">
    <p class="mb-2">You have not written anything yet.</p>
    <a href="/posts/add" class="btn btn-ink">Write your first post</a>
  </div>
<% } else { %>
  <div class="table-wrap table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>#</th>
          <th>Title</th>
          <th>Category</th>
          <th>Published</th>
          <th class="text-end">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% for (let i = 0; i < posts.length; i++) { %>
          <tr>
            <td><%= i + 1 %></td>
            <td><a href="/posts/<%= posts[i]._id %>"><%= posts[i].title %></a></td>
            <td><span class="tag"><%= posts[i].category %></span></td>
            <td><%= new Date(posts[i].createdAt).toLocaleDateString("en-IN", { day: "numeric", month: "short", year: "numeric" }) %></td>
            <td class="text-end">
              <a href="/posts/edit/<%= posts[i]._id %>" class="btn btn-outline-secondary btn-sm">Edit</a>
              <form method="POST" action="/posts/delete/<%= posts[i]._id %>" class="d-inline"
                    onsubmit="return confirm('Delete this post?')">
                <button type="submit" class="btn btn-outline-danger btn-sm">Delete</button>
              </form>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>

<%- include("partials/footer") %>
