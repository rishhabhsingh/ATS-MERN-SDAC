<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Blog Application</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Source+Serif+4:wght@400;600&display=swap" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>

<nav class="navbar navbar-expand site-nav">
  <div class="container">
    <a class="brand" href="/posts">Blog Application</a>
    <ul class="navbar-nav ms-auto align-items-center">
      <li class="nav-item"><a class="nav-link" href="/posts">Home</a></li>
      <% if (loggedIn) { %>
        <li class="nav-item"><a class="nav-link" href="/posts/my">My posts</a></li>
        <li class="nav-item"><a class="btn btn-accent btn-sm ms-2" href="/posts/add">Write</a></li>
        <li class="nav-item d-none d-md-block"><span class="hello ms-3"> Hello,<%= userName %></span></li>
        <li class="nav-item"><a class="nav-link" href="/logout">Logout</a></li>
      <% } else { %>
        <li class="nav-item"><a class="nav-link" href="/login">Login</a></li>
        <li class="nav-item"><a class="btn btn-accent btn-sm ms-2" href="/register">Register</a></li>
      <% } %>
    </ul>
  </div>
</nav>

<main>
<div class="container py-4">
