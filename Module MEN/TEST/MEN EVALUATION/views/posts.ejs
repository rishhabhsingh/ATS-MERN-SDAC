<%- include("partials/header") %>

<section class="masthead">
  <h1>Small notes on things worth writing down</h1>
  <p>Read what others are writing, or register and publish your own posts.</p>
</section>

<% if (posts.length === 0) { %>
  <div class="empty">
    <p class="mb-2">No posts yet.</p>
    <a href="/posts/add" class="btn btn-ink">Write the first post</a>
  </div>
<% } else { %>

  <a href="/posts/<%= posts[0]._id %>" class="featured mb-4">
    <span class="tag"><%= posts[0].category %></span>
    <h2 class="mt-3"><%= posts[0].title %></h2>
    <p class="excerpt mb-3">
  <%= (posts[0].content || "").substring(0, 220) %>
</p>
    <span class="meta">
  By <%= posts[0].authorName || "Unknown Author" %>
  on <%= new Date(posts[0].createdAt).toLocaleDateString("en-IN") %>
</span>
  </a>

  <div class="row g-3">
    <% for (let i = 1; i < posts.length; i++) { %>
      <div class="col-md-6">
        <a href="/posts/<%= posts[i]._id %>" class="post-card">
          <span class="tag"><%= posts[i].category %></span>
          <h3 class="mt-2"><%= posts[i].title %></h3>
          <p class="excerpt"><%= (posts[i].content || "").substring(0, 130) %></p>
          <span class="meta">
    By <%= posts[i].authorName || "Unknown Author" %>
    on <%= new Date(posts[i].createdAt).toLocaleDateString("en-IN") %>
  </span>
        </a>
      </div>
    <% } %>
  </div>

<% } %>

<%- include("partials/footer") %>


